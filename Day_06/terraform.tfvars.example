# ==============================================================================
# Day 06: Example Variable Definitions (terraform.tfvars.example)
# 31 Days of Terraform (AWS)
# ==============================================================================

# Project Configuration
project_name = "my-aws-project"
environment  = "dev"
region       = "us-east-1"

# Network Configuration
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# Tags
tags = {
  Owner      = "DevOps-Team"
  Department = "Cloud-Infrastructure"
  CostCenter = "DevOps-001"
  Project    = "TerraformLearning"
}
